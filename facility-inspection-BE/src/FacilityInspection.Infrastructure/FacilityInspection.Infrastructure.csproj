<Project Sdk="Microsoft.NET.Sdk">

  <!--
    INFRASTRUCTURE LAYER
    Technical, non-data concerns that implement Application abstractions:
    JWT token generation, current-user accessor, email/notification senders,
    file storage, date-time provider and Hangfire background jobs.
    References Application + Domain.
  -->

  <!-- Grants access to ASP.NET Core abstractions (IHttpContextAccessor, auth builder). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FacilityInspection.Application\FacilityInspection.Application.csproj" />
    <ProjectReference Include="..\FacilityInspection.Domain\FacilityInspection.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>

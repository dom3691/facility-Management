{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FacilityInspection;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "HangfireConnection": "Server=localhost;Database=FacilityInspectionHangfire;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "Issuer": "FacilityInspection.API",
    "Audience": "FacilityInspection.Client",
    "SecretKey": "K7mP2xQ9vL4nR8sT1wY6bC3dF5gH0jZa",
    "AccessTokenExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "Email": {
    "Provider": "Logging",
    "FromAddress": "noreply@facility-inspection.local",
    "FromName": "Facility Inspection System",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true
    }
  },
  "FileStorage": {
    "BasePath": "wwwroot/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/facility-inspection-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
